# Local model/download caches.
.cache/
cache/
hf_cache/

# Raw media and bulk corpus exports. Keep these local unless a separate
# publication, redaction, or Git LFS decision is made.
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.webm
*.mp4
*.mov
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Generated dataset/model files are reproducible outputs, not source docs.
*.arrow
*.parquet
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.safetensors
*.bin

# Sensitive / large local JANUS data. Keep these local unless a separate
# controlled-data publication or Git LFS decision is made.
00_source_archives/
10_extracted_parts/
20_inventory/
40_breeze_asr25_finetune_dataset/hf_audiofolder/
40_breeze_asr25_finetune_dataset/manifests/
40_breeze_asr25_finetune_dataset/reports/
50_janus_data_library/
90_legacy_imports/

# Large training artifacts should stay local unless explicitly packaged.
**/checkpoint-*/
**/checkpoints/
**/wandb/
**/mlruns/
**/lightning_logs/
**/tensorboard/
**/outputs/
*.ckpt
*.onnx
*.gguf

# Keep experiment records trackable, but avoid accidental bulk outputs.
70_experiments/runs/*/artifacts/
70_experiments/runs/*/predictions/
70_experiments/runs/*/logs/
70_experiments/runs/*/models/

# v2.0 multimodal runtime gates keep row-level inputs/outputs local-only.
*.local.tsv
*.local.jsonl
*hypothesis*.jsonl
*hypotheses*.jsonl

# Isolated runtime/model-cache lanes for large multimodal smoke tests.
70_experiments/runtime_lanes/
